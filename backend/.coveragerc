[run]
data_file = .reports/.coverage
source = .
omit =
    tests/*
    scripts/*
    */venv/*
    */.venv/*

[report]
# Include untouched modules in directories without __init__.py.
include_namespace_packages = True

[html]
directory = .reports/htmlcov

[xml]
output = .reports/coverage.xml

[json]
output = .reports/coverage.json
