# Copy to backend/.env and fill in. Never commit .env.
#
# Both values: Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://vblyhqppnmcrrumudizn.supabase.co
SUPABASE_ANON_KEY=

# Supabase dashboard -> Project Settings -> API -> service_role key.
# Admin key that skips row-level security. Used only by
# services/notification_service.py. Never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# SendGrid dashboard -> Settings -> API Keys (Custom Access, Mail Send only).
SENDGRID_API_KEY=
# Must match the Single Sender verified in SendGrid.
SENDGRID_FROM_EMAIL=connectspheret7@gmail.com

# Where the Vite dev server runs, for CORS.
FRONTEND_ORIGIN=http://localhost:5173
